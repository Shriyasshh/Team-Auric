# ==========================================
# MediVault Environment Variables
# ==========================================

# 1. Supabase (Frontend & Backend)
# Get these from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. FastAPI Backend
# Generate a secure 32-byte key for AES-GCM (e.g. openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here
# Optional: backend port
PORT=8000

# 3. MST Blockchain
# Get from testnetrpc.mstblockchain.com
MST_TESTNET_RPC=https://testnetrpc.mstblockchain.com
# For smart contract deployment (NEVER COMMIT THIS)
BLOCKCHAIN_PRIVATE_KEY=your-deployment-wallet-private-key
# Will be filled after Hardhat deployment
NEXT_PUBLIC_CONTRACT_ADDRESS=
